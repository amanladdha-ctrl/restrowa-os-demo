# Copy this file to .env and update values for your machine.

# PostgreSQL is the target database for RestroWA OS.
# Local Docker example:
# postgresql://restrowa:restrowa@localhost:5432/restrowa_os?schema=public
DATABASE_URL="postgresql://restrowa:restrowa@localhost:5432/restrowa_os?schema=public"

# Used to sign login cookies. Generate a long random value before production.
SESSION_SECRET="replace-with-a-long-random-secret"

# Local app URL used for generated links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
